# ⚠️ **절대 URL 을 넣지 말 것.** `/api/v1` 처럼 상대 경로여야 한다.
# refresh 쿠키가 서드파티가 되면 WebKit(iOS 전 브라우저 · macOS Safari)이 차단해서
# 1시간마다 로그아웃된다. 상대 경로여야 프록시를 타고 같은 오리진이 된다
# (배포는 netlify.toml, 로컬은 vite.config.ts 의 server.proxy).
VITE_API_BASE_URL=/api/v1
VITE_KAKAO_MAP_APP_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_OAUTH_REDIRECT_URI=

# 카카오 로그인 인가 URL 의 client_id (auth/lib/oauth.ts). 위 지도 키와는 다른 키다.
# 비워 두면 카카오 로그인 버튼이 에러 토스트만 띄운다 — 구글은 멀쩡해서 "카카오만 안 된다" 로 보인다.
# ⚠️ 번들에 평문으로 들어가고 그건 구조상 못 숨긴다 — OAuth client_id 는 주소창에도 뜨는
# 공개값이다(#258). 방어는 숨기기가 아니라 카카오 콘솔에서 안 쓰는 서비스 API 를 꺼 두는 것.
VITE_KAKAO_REST_API_KEY=

# 웹 푸시 VAPID 공개키. 서버 VAPID_PUBLIC_KEY 와 같은 값.
# 공개키라 번들에 들어가도 된다 — 비밀키(VAPID_PRIVATE_KEY)는 서버 전용이니 여기 두지 말 것.
# 비워 두면 근처 나무 알림 토글이 꺼진 채로 안내만 표시된다.
VITE_VAPID_PUBLIC_KEY=

# 토스페이먼츠 클라이언트 키. 없으면 결제/카드 등록 버튼이 아무 동작도 하지 않는다
# (requestBillingAuth 가 첫 줄에서 던진다). 시크릿 키는 서버 전용이니 여기 두지 말 것.
VITE_TOSS_CLIENT_KEY=
