VITE_API_BASE_URL=
VITE_KAKAO_MAP_APP_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_OAUTH_REDIRECT_URI=
# 웹 푸시 VAPID 공개키. 서버 VAPID_PUBLIC_KEY 와 같은 값.
# 공개키라 번들에 들어가도 된다 — 비밀키(VAPID_PRIVATE_KEY)는 서버 전용이니 여기 두지 말 것.
# 비워 두면 근처 나무 알림 토글이 꺼진 채로 안내만 표시된다.
VITE_VAPID_PUBLIC_KEY=

# 토스페이먼츠 클라이언트 키. 없으면 결제/카드 등록 버튼이 아무 동작도 하지 않는다
# (requestBillingAuth 가 첫 줄에서 던진다). 시크릿 키는 서버 전용이니 여기 두지 말 것.
VITE_TOSS_CLIENT_KEY=
